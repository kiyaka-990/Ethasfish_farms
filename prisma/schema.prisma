// Prisma schema - Ethasfish Farms (v2)
// Postgres (Neon, via Vercel Marketplace). Pooled connection for runtime,
// direct/unpooled connection for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ===================== IDENTITY =====================
// Authentication itself lives in Clerk. These tables hold the
// business-role + CRM data that hangs off a Clerk user id.

model StaffProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String
  role        String    @default("sales_manager") // admin | sales_manager | driver
  active      Boolean   @default(true)
  lastSeenAt  DateTime?
  driver      Driver?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CustomerProfile {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  phone       String?
  name        String?
  orders      Order[]
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===================== CATALOG =====================

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  type        String // whole | fillet | fingerling | feed | consultancy
  description String
  imageUrl    String?
  videoUrl    String?
  badge       String?
  active      Boolean          @default(true)
  sortOrder   Int              @default(0)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String // "Small", "Medium", "Large", "100 pcs"
  pieces     Int
  weight     String // "2kg", "600g", "100 fingerlings"
  perItem    String? // "~150g per fillet"
  priceKsh   Int
  stock      Int         @default(100)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]
}

// ===================== ORDERS =====================

model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerId      String?
  customer        CustomerProfile? @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String
  customerEmail   String?
  deliveryAddress String
  notes           String?
  subtotal        Int
  deliveryFee     Int              @default(200)
  total           Int
  vatRate         Int              @default(0) // percent; 0 while not VAT-registered. Prices are VAT-inclusive - this is informational, not added to total.
  vatAmount       Int              @default(0) // VAT portion already contained within subtotal
  status          String           @default("pending") // pending | paid | preparing | out_for_delivery | delivered | cancelled
  paymentStatus   String           @default("unpaid") // unpaid | processing | partially_paid | paid | failed
  paymentMethod   String           @default("mpesa") // mpesa | cash | credit
  dueDate         DateTime?        // credit sales: when the balance is expected by. Shown overdue after this passes while still unpaid.
  paidAt          DateTime?        // when the balance was fully settled (credit or manual record payment).
  channel         String           @default("online") // online | pos
  mpesaRef        String?
  mpesaCheckoutId String?
  items           OrderItem[]
  payments        Payment[]
  invoices        Invoice[]
  delivery        Delivery?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
}

// ===================== ERP: DELIVERY / LIVE TRACKING =====================
// One Delivery per fulfilment order: who is riding it, the geocoded
// destination pin, and the pickup→drop timestamps that feed delivery
// reports. The Order.status field stays the single fulfilment source of
// truth (paid | preparing | out_for_delivery | delivered) - Delivery
// mirrors it so driver/dispatch queries don't have to join the order.
model Delivery {
  id           String    @id @default(cuid())
  orderId      String    @unique
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driverId     String?
  driver       Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  status       String    @default("assigned") // assigned | picked_up | delivered | cancelled
  destLat      Float?    // geocoded from the order's delivery address (admin can correct on the map)
  destLng      Float?
  assignedAt   DateTime  @default(now())
  pickedUpAt    DateTime?
  deliveredAt  DateTime?
  cancelReason String?
  positions    DriverPosition[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([driverId, status])
  @@index([status])
}

model Driver {
  id          String    @id @default(cuid())
  staffId     String?   @unique // StaffProfile with role=driver - sign-in lives in Clerk
  staff       StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)
  name        String
  phone       String
  plate       String? // motorcycle/bike registration
  vehicle     String    @default("motorcycle") // motorcycle | bicycle | van
  active      Boolean   @default(true)
  lastLat     Float?    // latest ping - what the live map draws
  lastLng     Float?
  lastSeenAt  DateTime?
  deliveries  Delivery[]
  positions   DriverPosition[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// GPS history for the ride trail + distance travelled. Rows are pruned
// after 30 days on each ping so the table stays small.
model DriverPosition {
  id         String   @id @default(cuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deliveryId String?
  delivery   Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  lat        Float
  lng        Float
  speedKph   Float?
  recordedAt DateTime @default(now())

  @@index([driverId, recordedAt])
  @@index([deliveryId])
}

model OrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  variantId    String
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  productName  String
  variantLabel String
  unitPrice    Int
  quantity     Int
  lineTotal    Int
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      String   @default("mpesa")
  amount      Int
  status      String // initiated | success | failed
  reference   String?
  checkoutId  String?
  rawResponse String?
  createdAt   DateTime @default(now())
}

// ===================== CRM =====================

model Lead {
  id          String           @id @default(cuid())
  name        String
  phone       String?
  email       String?
  source      String           @default("chatbot") // chatbot | contact_form | manual | sales_agent
  status      String           @default("new") // new | contacted | qualified | won | lost
  notes       String?
  assignedTo  String? // StaffProfile.id
  customerId  String?
  customer    CustomerProfile? @relation(fields: [customerId], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// ===================== CMS (admin-editable frontend content) =====================

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // "home.hero", "home.stats", "services.intro", ...
  label     String // human-readable label shown in the admin CMS
  data      String // JSON blob - shape is interpreted by the section renderer
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Media {
  id         String   @id @default(cuid())
  url        String
  pathname   String
  kind       String   @default("image") // image | video
  alt        String?
  tags       String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

// ===================== CHATBOT / AI AGENTS =====================

model FaqEntry {
  id        String   @id @default(cuid())
  question  String
  answer    String
  keywords  String // comma-separated; the chatbot matches against these
  category  String   @default("general")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | bot
  content   String
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// A single call into an autonomous agent (sales agent, inventory agent, ...).
// Foundation for the agentic ERP/CRM layer - every tool call an agent makes
// is recorded here and mirrored into AuditLog.
model AgentRun {
  id         String   @id @default(cuid())
  agentKey   String // "sales-agent" | "inventory-agent" | ...
  sessionId  String?
  input      String?
  output     String?
  status     String   @default("completed") // running | completed | failed
  toolCalls  String? // JSON array of {tool, args, result}
  model      String?
  tokensUsed Int?
  createdAt  DateTime @default(now())

  @@index([agentKey, createdAt])
}

// Append-only activity trail for the secure admin portal: every admin
// action and every autonomous-agent action lands here.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // staff | agent | system | customer
  actorId    String? // clerk user id, agent key, or "system"
  actorName  String
  action     String // "product.update" | "order.status_change" | "agent.tool_call" | ...
  entityType String?
  entityId   String?
  summary    String
  metadata   String? // JSON
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ===================== ERP: INVOICING =====================

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  customerName  String
  customerEmail String?
  customerPhone String?
  customerAddr  String?
  items         InvoiceItem[]
  subtotal      Int
  taxRate       Int           @default(0) // percent
  taxAmount     Int           @default(0)
  total         Int
  status        String        @default("draft") // draft | sent | paid | overdue | void
  dueDate       DateTime?
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  notes         String?
  createdBy     String? // StaffProfile.id
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Int
  lineTotal   Int
}

// ===================== ERP: INVENTORY =====================

// ===================== ERP: FISH STOCK =====================
// Fresh-fish stock is tracked separately from shop ProductVariant stock.
// Fish are harvested from a source - a numbered cage, a numbered pond,
// or the hatchery - counted in pieces AND weighed in kg, pooled as farm
// stock, then distributed to outlets and sold there in pieces and/or
// kilograms. Balances are always derived:
//   farm stock   = harvests - distributions
//   outlet stock = distributions - sales
model Outlet {
  id             String              @id @default(cuid())
  name           String              @unique // "Kisumu" | "Nairobi" (more can be added)
  active         Boolean             @default(true)
  lowStockPieces Int                 @default(30) // alert when in-stock pieces fall to/below this (0 = that alert off)
  lowStockKg     Float               @default(15) // alert when in-stock kg fall to/below this (0 = that alert off)
  distributions  StockDistribution[]
  sales          OutletSale[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Harvest {
  id           String   @id @default(cuid())
  sourceType   String   @default("cage") // cage | pond | hatchery
  sourceNumber String   // "3", "P2", "H1" - cages and ponds are numbered
  pieces       Int      // counted fish
  weightKg     Float    // weighed on the scales
  note         String?
  recordedBy   String? // StaffProfile.name or agent name
  createdAt    DateTime @default(now())

  @@index([sourceType, sourceNumber])
  @@index([createdAt])
}

model StockDistribution {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  pieces     Int      @default(0)
  weightKg   Float    @default(0)
  estimated  Boolean  @default(false) // true when kg (or pieces) was derived from average weight, not measured
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([outletId])
  @@index([createdAt])
}

model OutletSale {
  id         String   @id @default(cuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  pieces     Int      @default(0) // sold by count...
  weightKg   Float    @default(0) // ...and/or by weight
  estimated  Boolean  @default(false) // true when kg (or pieces) was derived from average weight, not weighed
  amountKsh  Int      @default(0) // cash taken at the outlet
  channel    String   @default("counter") // counter | wholesale | mobile | market
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())

  @@index([outletId, createdAt])
}

model InventoryItem {
  id           String              @id @default(cuid())
  name         String
  category     String              @default("other") // feed | supplies | equipment | other
  unit         String // kg, bag, litre, piece
  quantity     Float               @default(0)
  reorderLevel Float               @default(0)
  costPerUnit  Int                 @default(0) // KSh
  notes        String?
  movements    InventoryMovement[]
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model InventoryMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String // in | out | adjustment
  quantity  Float
  reason    String?
  reference String? // e.g. PO number or order number
  createdBy String?
  createdAt DateTime      @default(now())

  @@index([itemId])
}

// ===================== ERP: ACCOUNTING =====================

model Expense {
  id          String   @id @default(cuid())
  category    String   @default("other") // feed | labor | utilities | transport | maintenance | other
  description String
  amount      Int
  paidTo      String?
  receiptUrl  String?
  date        DateTime @default(now())
  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([date])
}

// ===================== ERP: SUPPLIERS & PURCHASING =====================

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  category       String          @default("other") // feed | equipment | fingerlings | other
  notes          String?
  active         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       String              @default("draft") // draft | ordered | received | cancelled
  items        PurchaseOrderItem[]
  totalCost    Int                 @default(0)
  expectedDate DateTime?
  receivedAt   DateTime?
  notes        String?
  createdBy    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float
  unitCost        Int
  lineTotal       Int
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  createdAt DateTime @default(now())
}

// ===================== TAX / COMPLIANCE =====================
// Single-row settings table (id is always "singleton"). vatRate 0 means
// VAT is off - Order/POS totals stay untouched either way since Kenyan
// retail prices are VAT-inclusive; a nonzero rate only changes what
// portion of the existing price is broken out as VAT on receipts.
model BusinessSettings {
  id        String   @id @default("singleton")
  vatRate   Int      @default(0) // percent, e.g. 16. 0 = not VAT-registered yet.
  kraPin    String? // shown on receipts once VAT-registered
  updatedAt DateTime @updatedAt
}

// ===================== MARKETING =====================
// Site-wide promo banner entries ("New harvest in!", "20% off fillets").
// Staff-level (not admin-only) by design - branch sales managers should be
// able to announce their own sale/harvest without needing an admin.
model Promotion {
  id        String    @id @default(cuid())
  type      String    @default("announcement") // sale | harvest | announcement | restock
  message   String
  ctaLabel  String?
  ctaHref   String?
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdBy String? // StaffProfile.id
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
