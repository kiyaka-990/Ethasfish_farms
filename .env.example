# ============================================
# ETHASFISH FARMS - ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# Database (PostgreSQL recommended; SQLite works for local dev)
# Local SQLite: file:./dev.db
# Production (Supabase/Neon/Railway): postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# JWT secret for admin auth (generate: openssl rand -base64 32)
JWT_SECRET="change-this-to-a-very-long-random-string-min-32-chars"

# Admin default credentials (created on seed)
ADMIN_EMAIL="admin@ethasfish.co.ke"
ADMIN_PASSWORD="changeme123"

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================
# M-PESA DARAJA API (Safaricom)
# Get from: https://developer.safaricom.co.ke
# ============================================
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_ENV="sandbox"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"

# ============================================
# WHATSAPP BUSINESS API (Meta)
# Get from: https://developers.facebook.com/apps
# ============================================
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="ethasfish-verify-2025"
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"

# ============================================
# AFRICA'S TALKING SMS (for receipt fallback if WhatsApp unavailable)
# Get from: https://account.africastalking.com
# ============================================
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# ============================================
# OPENAI / ANTHROPIC (optional - for advanced chatbot)
# Without keys, built-in rule-based + DB-aware bot still works
# ============================================
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ============================================
# EMAIL (Resend - optional, for order confirmations)
# Get from: https://resend.com
# ============================================
RESEND_API_KEY=""
FROM_EMAIL="orders@ethasfish.co.ke"

# ============================================
# GOOGLE MAPS (optional - works without key for embed)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ============================================
# BUSINESS DETAILS
# ============================================
NEXT_PUBLIC_BUSINESS_NAME="Ethasfish Farms"
NEXT_PUBLIC_BUSINESS_PHONE="+254700000000"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@ethasfish.co.ke"
NEXT_PUBLIC_BUSINESS_LOCATION="Othany East, Seme, Kisumu County, Kenya"
