# ============================================
# ETHASFISH FARMS - ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in values
# ============================================

# Database - Postgres (Neon, via Vercel Marketplace).
# Auto-provisioned by `vercel integration add neon` + `vercel env pull`.
# DATABASE_URL = pooled connection (runtime), DATABASE_URL_UNPOOLED = direct
# connection (migrations / `prisma db push`).
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# ============================================
# AUTHENTICATION (Clerk, via Vercel Marketplace)
# Auto-provisioned by `vercel integration add clerk` + `vercel env pull`.
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Email of the person who should hold the first "admin" seat. On `db:seed`
# a StaffProfile row is pre-provisioned for this address - sign in with it
# once Clerk is set up to claim full admin access to /admin.
ADMIN_EMAIL="admin@ethasfish.co.ke"

# ============================================
# AI AGENTS (Vercel AI Gateway)
# No key needed when deployed on Vercel / after `vercel env pull` - the
# gateway authenticates via VERCEL_OIDC_TOKEN automatically. Set
# AI_GATEWAY_API_KEY only for environments without OIDC (e.g. plain CI).
# ============================================
AI_GATEWAY_API_KEY=""

# ============================================
# MEDIA (Vercel Blob, via `vercel storage create`)
# Auto-provisioned - no manual token needed when using OIDC (default).
# ============================================
BLOB_STORE_ID=""

# Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================
# M-PESA DARAJA API (Safaricom)
# Get from: https://developer.safaricom.co.ke
# ============================================
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_ENV="sandbox"
MPESA_CALLBACK_URL="https://yourdomain.com/api/payments/mpesa/callback"
# Random secret appended to the callback URL as ?token=... - required so
# the callback route can tell a real Safaricom callback apart from a
# forged "payment succeeded" POST. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=""

# ============================================
# WHATSAPP BUSINESS API (Meta)
# Get from: https://developers.facebook.com/apps
# ============================================
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="ethasfish-verify-2025"
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"

# ============================================
# AFRICA'S TALKING SMS (for receipt fallback if WhatsApp unavailable)
# Get from: https://account.africastalking.com
# ============================================
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# ============================================
# EMAIL (Resend - optional, for order confirmations)
# Get from: https://resend.com
# ============================================
RESEND_API_KEY=""
FROM_EMAIL="orders@ethasfish.co.ke"

# ============================================
# GOOGLE MAPS (optional - works without key for embed)
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ============================================
# BUSINESS DETAILS
# ============================================
NEXT_PUBLIC_BUSINESS_NAME="Ethasfish Farms"
NEXT_PUBLIC_BUSINESS_PHONE="+254700000000"
NEXT_PUBLIC_BUSINESS_EMAIL="hello@ethasfish.co.ke"
NEXT_PUBLIC_BUSINESS_LOCATION="Othany East, Seme, Kisumu County, Kenya"
